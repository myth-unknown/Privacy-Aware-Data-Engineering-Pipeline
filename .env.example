# Privacy-Aware Data Engineering Pipeline
# Environment Configuration Example
# Copy this file to .env and update with your settings

# Application Settings
PIPELINE_MAX_FILE_SIZE_MB=50
PIPELINE_MAX_ROWS=100000

# Database
DUCKDB_PATH=data/pipeline.duckdb

# NLP Model
SPACY_MODEL=en_core_web_lg

# Anonymization
# Generate secure key with: python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYM_KEY=your-secret-key-here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log

# Streamlit (optional overrides)
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=false
